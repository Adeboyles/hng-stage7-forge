# Forge Platform Environment Variables

# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Path to config file inside containers
FORGE_CONFIG=/app/config.yaml

# Engine settings
ENGINE_PORT=8000

# Registry settings
REGISTRY_PORT=8001

FORGE_NETWORK = "forge-internal"
REGISTRY_HOST = "registry"
REGISTRY_PORT = 8001

